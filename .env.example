# agent-from-scratch/.env.example
# Copy this file to .env and fill in real values.
#
# DeepSeek configuration.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Web search configuration.
TAVILY_API_KEY=

# Optional: move sessions, traces, and project memory out of the target workspace.
# Leave empty to use the workspace-local .agents/ directory.
AGENT_STATE_DIR=
